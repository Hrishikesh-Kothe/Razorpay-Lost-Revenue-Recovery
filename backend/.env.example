# Copy to backend/.env and fill in real values.
# NEVER commit backend/.env

# Razorpay API credentials (Dashboard → API Keys)
RZP_KEY_ID=
RZP_KEY_SECRET=

# Optional: Razorpay webhook secret for signature verification
# (Dashboard → Webhooks → Secret). Not enforced yet in this PoC.
RZP_WEBHOOK_SECRET=

# SQLAlchemy database URL
# Local default (no password):
DATABASE_URL=sqlite:///./recovery.db
# Example Postgres (do not put real passwords in this file):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Enable GET /razorpay-test probe (keep false in production)
ENABLE_RAZORPAY_TEST=false

# Recovery email (Resend free tier — https://resend.com)
# Keep EMAIL_SEND_LIVE=false to simulate (saves daily free credits).
# Set EMAIL_SEND_LIVE=true only for real demo sends.
EMAIL_SEND_LIVE=false
EMAIL_API_KEY=
EMAIL_FROM=Revenue Recovery <onboarding@resend.dev>
# For demos, force all outreach to your inbox:
EMAIL_TO_OVERRIDE=
# Fallback if no override and no customer mapping:
EMAIL_DEFAULT_TO=

# Frontend (set in frontend/.env.local — also gitignored)
# NEXT_PUBLIC_API_URL=http://localhost:8000
